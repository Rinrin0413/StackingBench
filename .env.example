# Copy to .env, then enter the FULL account token locally (UUID:secret).
# Never commit .env or paste the key into a prompt or a command argument.
SAKURA_AI_API_KEY=

# TypeSafe Jev (server-side only)
TYPESAFE_API_KEY=

# Preset OpenAI-compatible connections (server-side only)
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Optional legacy local endpoint override. New connection profiles use a
# complete API prefix such as http://localhost:8082/v1.
LLM_BASE_URL=http://localhost:8082
